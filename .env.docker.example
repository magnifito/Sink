# Private site token for the admin dashboard (at least 32 characters required)
# Generate with: openssl rand -hex 32
NUXT_SITE_TOKEN=

# Host port to expose Sink (default: 7466)
SINK_PORT=7466

# Set to true when running behind a trusted reverse proxy (e.g., Caddy, Traefik, Nginx)
NUXT_TRUST_PROXY=false

# Number of days to retain visitor analytics events (default: 90)
NUXT_ANALYTICS_RETENTION_DAYS=90

# Set to true to disable automatic daily link backups to /data/objects
NUXT_DISABLE_AUTO_BACKUP=false

# Days to keep automatic link backups; manual backups are never deleted (0 keeps all)
NUXT_BACKUP_RETENTION_DAYS=30

# Number of daily SQLite snapshots to keep in /data/snapshots (0 disables snapshots)
NUXT_SNAPSHOT_KEEP=7

# Set to true to store a keyed hash instead of the raw visitor IP
NUXT_ANALYTICS_HASH_IP=false

# Optional published image to pull instead of building locally
# SINK_IMAGE=ghcr.io/<owner>/sink:latest

# Optional local City or Country MMDB file visible inside the Sink container
# compose.geo.yaml sets this to /geo/GeoLite2-City.mmdb
NUXT_GEO_DATABASE_PATH=
